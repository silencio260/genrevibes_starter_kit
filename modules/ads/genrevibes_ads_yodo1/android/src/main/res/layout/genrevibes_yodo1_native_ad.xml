<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout MAS fills with a native creative. The ids are mapped to their roles in
  Yodo1NativePlatformView; keep the two in step. Sizes stay modest so the ad
  sits inside an app's own screen rather than dominating it, and the advertiser
  label and options area are present because networks require attribution and a
  privacy control to be visible.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/genrevibes_yodo1_native_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/genrevibes_yodo1_native_title"
                android:textColor="#1C1C1E"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/genrevibes_yodo1_native_advertiser"
                android:textColor="#444444"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/genrevibes_yodo1_native_options"
            android:layout_width="20dp"
            android:layout_height="20dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/genrevibes_yodo1_native_body"
        android:textColor="#444444"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="13sp" />

    <FrameLayout
        android:id="@+id/genrevibes_yodo1_native_media"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/genrevibes_yodo1_native_cta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAllCaps="false" />
</LinearLayout>
