.DS_Store
.dart_tool/
build/

# Package tool caches, consolidated into one directory by
# tool/link_build_dirs.sh. The rules above end in a slash and so do not match
# the per-package symlinks, which git sees as files.
submodule-build-dir/
packages/*/build
packages/*/.dart_tool
.flutter-plugins
.flutter-plugins-dependencies
.packages
coverage/
doc/api/
*.iml
packages/*/pubspec.lock

# IDE state
.idea/
.vscode/

# Local environment and secrets
.env
.env.*
*.env

# Real credential files. Never commit these. The committed template for the
# example apps is examples/<app>/env.example.json.
env/
examples/*/env/
*.jks
*.keystore
key.properties

# Generated platform files
android/.gradle/
ios/Pods/
ios/.symlinks/
macos/Pods/
macos/.symlinks/
