.DS_Store
.dart_tool/
build/

# Consolidated package tool caches.
#
# Each package's build/ and .dart_tool/ is a committed symlink into
# submodule-build-dir/<package>/, so a fresh clone gets the layout with no
# setup step. Git cannot store an empty directory, and a symlink whose target
# is missing makes `pub get` fail outright rather than recreate it, so each
# target holds a committed .gitkeep. Everything written into them is ignored.
#
# These rules must stay below the plain build/ and .dart_tool/ rules above:
# the last matching pattern wins, and those would otherwise hide the targets.
submodule-build-dir/**
!submodule-build-dir/*/
!submodule-build-dir/*/*/
!submodule-build-dir/*/*/.gitkeep
.flutter-plugins
.flutter-plugins-dependencies
.packages
coverage/
doc/api/
*.iml
modules/*/*/pubspec.lock

# IDE state
.idea/
.vscode/

# Local environment and secrets
.env
.env.*
*.env

# Real credential files. Never commit these. The committed template for the
# example apps is examples/<app>/env.example.json.
env/
examples/*/env/
*.jks
*.keystore
key.properties

# Generated platform files
android/.gradle/
ios/Pods/
ios/.symlinks/
macos/Pods/
macos/.symlinks/
